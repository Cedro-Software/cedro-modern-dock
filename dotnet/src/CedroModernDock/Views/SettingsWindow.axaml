<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CedroModernDock.ViewModels"
        xmlns:med="using:Avalonia.Media"
        xmlns:ctl="using:CedroModernDock.Controls"
        x:Class="CedroModernDock.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icons/cedro/logo_256.png"
        Width="1000" Height="700"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource CedroWindowBackground}"
        Foreground="{DynamicResource CedroText}"
        FontSize="13"
        Closed="OnClosed">

    <Window.Styles>
        <!-- ================= Left navigation (TabControl restyled) ================= -->
        <Style Selector="TabControl.nav">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="2"/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="240,*">
                        <Border Background="{DynamicResource CedroSidebarBackground}"
                                BorderBrush="{DynamicResource CedroCardBorder}" BorderThickness="0,0,1,0">
                            <DockPanel Margin="14,20,14,14">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="11" Margin="8,0,0,26">
                                    <Image Source="/Assets/icons/cedro/logo_256.png" Width="34" Height="34"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Cedro Modern Dock" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource CedroText}"/>
                                        <TextBlock Text="{TemplateBinding Tag}" FontSize="11"
                                                   Foreground="{DynamicResource CedroTextTertiary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </DockPanel>
                        </Border>
                        <ContentPresenter Grid.Column="1" Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.nav TabItem">
            <Setter Property="Foreground" Value="{DynamicResource CedroTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="navRoot" Background="{TemplateBinding Background}" CornerRadius="7" Padding="12,9">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Name="navPill" Width="3" Height="16" CornerRadius="2"
                                    Background="{DynamicResource CedroAccent}" Margin="-12,0,9,0" Opacity="0"/>
                            <ContentPresenter Grid.Column="1" Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.nav TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource CedroControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CedroText}"/>
        </Style>
        <Style Selector="TabControl.nav TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource CedroControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CedroText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TabControl.nav TabItem:selected /template/ Border#navPill">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Path.navIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding $parent[TabItem].Foreground}"/>
        </Style>

        <!-- ================= Page content ================= -->
        <Style Selector="ScrollViewer.page">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="StackPanel.page">
            <Setter Property="Margin" Value="36,30,36,36"/>
            <Setter Property="Spacing" Value="12"/>
            <Setter Property="MaxWidth" Value="880"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Dock items list rows -->
        <Style Selector="ListBox#ItemsList ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4,1"/>
        </Style>
        <Style Selector="ListBox#ItemsList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CedroAccentSubtle}"/>
        </Style>

        <!-- Color swatches -->
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.swatch:pointerover">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="RenderTransform" Value="scale(1.08)"/>
        </Style>

        <!-- Theme gallery cards -->
        <Style Selector="Border.themeCard">
            <Setter Property="Width" Value="208"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CedroCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CedroCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.themeCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CedroCardBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        </Style>
        <Style Selector="Border.themeCard.active">
            <Setter Property="BorderBrush" Value="{DynamicResource CedroAccent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource CedroAccent}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Styles>

    <TabControl Classes="nav" SelectedIndex="{Binding SelectedPageIndex}" Tag="{Binding VersionText}">

        <!-- =============================== 1. Dock items =============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Path Classes="navIcon" Data="M2.5 9.5 H13.5 A1 1 0 0 1 14.5 10.5 V12.5 A1 1 0 0 1 13.5 13.5 H2.5 A1 1 0 0 1 1.5 12.5 V10.5 A1 1 0 0 1 2.5 9.5 Z M4.5 9.5 V6.5 M8 9.5 V4.5 M11.5 9.5 V6.5"/>
                    <TextBlock Text="{Binding TabItems}"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Classes="page">
                <StackPanel Classes="page">
                    <TextBlock Classes="pageTitle" Text="{Binding TabItems}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding ItemsSubtitle}" Margin="0,0,0,8"/>

                    <!-- Toolbar -->
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="accent" Click="OnAddProgram" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.AddProgram}"/>
                                <TextBlock Text="{Binding AddProgramText}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Click="OnAddFolder" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.AddFolder}"/>
                                <TextBlock Text="{Binding AddFolderText}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Click="OnAddModule" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.AddModule}"/>
                                <TextBlock Text="{Binding AddModuleText}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Click="OnAddSeparator" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.Separator}"/>
                                <TextBlock Text="{Binding AddSeparatorText}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Border Classes="card" Padding="6">
                        <Grid RowDefinitions="*,Auto">
                            <Grid>
                                <ListBox x:Name="ItemsList" ItemsSource="{Binding ItemEntries}" SelectedIndex="{Binding SelectedItemIndex}"
                                         Background="Transparent" BorderThickness="0"
                                         MinHeight="260" MaxHeight="380"
                                         DragDrop.AllowDrop="True"
                                         DragDrop.DragOver="OnItemsDragOver"
                                         DragDrop.DragLeave="OnItemsDragLeave"
                                         DragDrop.Drop="OnItemsDrop"
                                         PointerMoved="OnItemsPointerMoved"
                                         PointerReleased="OnItemsPointerReleased"
                                         PointerCaptureLost="OnItemsPointerCaptureLost">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DockItemListEntry">
                                            <Grid ColumnDefinitions="Auto,Auto,*" Cursor="SizeAll">
                                                <Path Data="M5.5 4 h.01 M10.5 4 h.01 M5.5 8 h.01 M10.5 8 h.01 M5.5 12 h.01 M10.5 12 h.01"
                                                      Stroke="{DynamicResource CedroTextTertiary}" StrokeThickness="2"
                                                      StrokeLineCap="Round" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <Image Grid.Column="1" Source="{Binding Icon}" Width="26" Height="26" Margin="8,0,12,0"
                                                       Stretch="Uniform" VerticalAlignment="Center"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11"
                                                               Foreground="{DynamicResource CedroTextTertiary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- Insertion indicator shown while a drag hovers the list. -->
                                <Border x:Name="DropIndicator" IsVisible="False" Height="2"
                                        Background="{DynamicResource CedroAccent}" CornerRadius="1"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                            </Grid>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource CedroCardBorder}" BorderThickness="0,1,0,0"
                                    Padding="8,10,8,4" Margin="0,6,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="helper" Text="{Binding ItemsDragHint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Classes="subtle" Click="OnMoveUp" IsEnabled="{Binding CanMoveUp}" ToolTip.Tip="{Binding MoveUpText}" Padding="8,6">
                                            <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.ArrowUp}"/>
                                        </Button>
                                        <Button Classes="subtle" Click="OnMoveDown" IsEnabled="{Binding CanMoveDown}" ToolTip.Tip="{Binding MoveDownText}" Padding="8,6">
                                            <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.ArrowDown}"/>
                                        </Button>
                                        <Button Classes="danger" Click="OnRemove" IsEnabled="{Binding CanRemove}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.Remove}"/>
                                                <TextBlock Text="{Binding RemoveText}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- =============================== 2. Icons =============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Path Classes="navIcon" Data="M2.5 2.5 H7 V7 H2.5 Z M9 2.5 H13.5 V7 H9 Z M2.5 9 H7 V13.5 H2.5 Z M9 9 H13.5 V13.5 H9 Z"/>
                    <TextBlock Text="{Binding TabIconsCustomization}"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Classes="page">
                <StackPanel Classes="page">
                    <TextBlock Classes="pageTitle" Text="{Binding TabIconsCustomization}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding IconsSubtitle}" Margin="0,0,0,8"/>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cardTitle" Text="{Binding IconSizeTitle}"/>
                                    <TextBlock Classes="helper" Text="{Binding IconSizeHelper}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding IconSize, StringFormat='{}{0} px'}"/>
                            </Grid>
                            <Slider Minimum="16" Maximum="80" Value="{Binding IconSize}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cardTitle" Text="{Binding SpacingTitle}"/>
                                    <TextBlock Classes="helper" Text="{Binding SpacingHelper}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding IconSpacing, StringFormat='{}{0} px'}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="20" Value="{Binding IconSpacing}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cardTitle" Text="{Binding TintIconsTitle}"/>
                                    <TextBlock Classes="helper" Text="{Binding TintColorHelper}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding TintIcons}"/>
                            </Grid>
                            <StackPanel Spacing="6" IsVisible="{Binding TintIcons}" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding PresetColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="med:IBrush">
                                            <Border Classes="swatch" Background="{Binding}" PointerPressed="OnTintPresetColorPressed"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="44" Height="30" CornerRadius="8" BorderBrush="#40FFFFFF" BorderThickness="1"
                                            Background="{Binding TintColorBrush}"/>
                                    <Button Classes="subtle" Content="{Binding CustomColorText}" Click="OnCustomTintColor"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- =============================== 3. Dock appearance =============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Path Classes="navIcon" Data="M3.5 4.5 H12.5 A2 2 0 0 1 14.5 6.5 V9.5 A2 2 0 0 1 12.5 11.5 H3.5 A2 2 0 0 1 1.5 9.5 V6.5 A2 2 0 0 1 3.5 4.5 Z"/>
                    <TextBlock Text="{Binding TabDockCustomization}"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Classes="page">
                <StackPanel Classes="page">
                    <TextBlock Classes="pageTitle" Text="{Binding TabDockCustomization}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding AppearanceSubtitle}" Margin="0,0,0,8"/>

                    <Border Classes="infoBar" IsVisible="{Binding HasThemeOverrideNotice}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Path Data="{x:Static ctl:Glyphs.Theme}" Stroke="{DynamicResource CedroAccent}" StrokeThickness="1.4"
                                  StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding ThemeOverrideNotice}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Classes="link" Content="{Binding TabThemes}" Click="OnGoToThemes" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Classes="card" IsEnabled="{Binding CanEditTransparency}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cardTitle" Text="{Binding TransparencyTitle}"/>
                                    <TextBlock Classes="helper" Text="{Binding TransparencyHelper}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding Transparency, StringFormat='{}{0} %'}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Transparency}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*">
                        <Border Classes="card" IsEnabled="{Binding CanEditRounding}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="cardTitle" Text="{Binding RoundingTitle}"/>
                                        <TextBlock Classes="helper" Text="{Binding RoundingHelper}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding BorderRounding, StringFormat='{}{0} px'}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="30" Value="{Binding BorderRounding}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card" IsEnabled="{Binding CanEditPadding}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="cardTitle" Text="{Binding DockPaddingTitle}"/>
                                        <TextBlock Classes="helper" Text="{Binding DockPaddingHelper}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding DockPadding, StringFormat='{}{0} px'}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="30" Value="{Binding DockPadding}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="card" IsEnabled="{Binding CanEditDockColor}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="cardTitle" Text="{Binding BgColorTitle}"/>
                                <TextBlock Classes="helper" Text="{Binding BgColorHelper}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding PresetColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="med:IBrush">
                                        <Border Classes="swatch" Background="{Binding}" PointerPressed="OnPresetColorPressed"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="44" Height="30" CornerRadius="8" BorderBrush="#40FFFFFF" BorderThickness="1"
                                        Background="{Binding DockColorBrush}"/>
                                <Button Classes="subtle" Content="{Binding CustomColorText}" Click="OnCustomColor"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- =============================== 4. Themes =============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Path Classes="navIcon" Data="{x:Static ctl:Glyphs.Theme}"/>
                    <TextBlock Text="{Binding TabThemes}"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Classes="page">
                <StackPanel Classes="page">
                    <TextBlock Classes="pageTitle" Text="{Binding TabThemes}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding ThemesSubtitle}" Margin="0,0,0,8"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="accent" Click="OnImportTheme" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.Import}"/>
                                <TextBlock Text="{Binding ImportThemeText}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Click="OnCreateTheme" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.Create}"/>
                                <TextBlock Text="{Binding CreateThemeText}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Click="OnOpenThemesFolder" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.OpenLocation}"/>
                                <TextBlock Text="{Binding OpenThemesFolderText}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Click="OnReloadThemes" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.Refresh}"/>
                                <TextBlock Text="{Binding ReloadThemesText}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Border Classes="warningBar" IsVisible="{Binding HasThemeErrors}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ThemeErrorsTitle}" FontWeight="SemiBold" Foreground="{DynamicResource CedroWarning}"/>
                            <TextBlock Text="{Binding ThemeErrors}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ThemeCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemeCardViewModel">
                                <Border Classes="themeCard" Classes.active="{Binding IsActive}"
                                        PointerPressed="OnThemeCardPressed"
                                        ToolTip.Tip="{Binding Description}">
                                    <StackPanel>
                                        <!-- Preview: a miniature dock on a wallpaper-like backdrop -->
                                        <Panel Height="104">
                                            <Panel.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Offset="0" Color="#FF3A5378"/>
                                                    <GradientStop Offset="0.55" Color="#FF6A5D8E"/>
                                                    <GradientStop Offset="1" Color="#FFC98B7A"/>
                                                </LinearGradientBrush>
                                            </Panel.Background>
                                            <Panel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                                                <Border Background="{Binding PreviewBackground}"
                                                        BorderBrush="{Binding PreviewBorderBrush}"
                                                        BorderThickness="{Binding PreviewBorderThickness}"
                                                        CornerRadius="{Binding PreviewCornerRadius}"
                                                        BoxShadow="{Binding PreviewShadow}"/>
                                                <Border BorderBrush="{Binding PreviewHighlight}" BorderThickness="0,1,0,0"
                                                        CornerRadius="{Binding PreviewCornerRadius}" Margin="1"
                                                        IsVisible="{Binding HasPreviewHighlight}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,7,8,5">
                                                    <StackPanel Spacing="3">
                                                        <Border Width="22" Height="22" CornerRadius="6" Background="#FF4C9AFF"/>
                                                        <Border Width="{Binding PreviewIndicatorWidth}" Height="{Binding PreviewIndicatorHeight}"
                                                                CornerRadius="{Binding PreviewIndicatorRadius}" Background="{Binding PreviewIndicator}"
                                                                HorizontalAlignment="Center" IsVisible="{Binding PreviewHasIndicator}"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="3">
                                                        <Border Width="22" Height="22" CornerRadius="6" Background="#FF34C77B"/>
                                                        <Border Width="{Binding PreviewIndicatorWidth}" Height="{Binding PreviewIndicatorHeight}"
                                                                CornerRadius="{Binding PreviewIndicatorRadius}" Background="{Binding PreviewIndicator}"
                                                                HorizontalAlignment="Center" IsVisible="{Binding PreviewHasIndicator}"/>
                                                    </StackPanel>
                                                    <Border Width="22" Height="22" CornerRadius="6" Background="#FFFFB547" VerticalAlignment="Top"/>
                                                    <Border Width="22" Height="22" CornerRadius="6" Background="#FFFF6B6B" VerticalAlignment="Top"/>
                                                    <Border Width="22" Height="22" CornerRadius="6" Background="#FFB07CFF" VerticalAlignment="Top"/>
                                                </StackPanel>
                                            </Panel>
                                            <Border Classes="badge" IsVisible="{Binding IsActive}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Path Data="{x:Static ctl:Glyphs.Check}" Stroke="White" StrokeThickness="2"
                                                          StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16"
                                                          RenderTransform="scale(0.7)"/>
                                                    <TextBlock Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ActiveBadgeText}"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                        <!-- Name, author, actions -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="14,10,10,12">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Byline}" FontSize="11"
                                                           Foreground="{DynamicResource CedroTextTertiary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                        IsVisible="{Binding IsUserTheme}" VerticalAlignment="Center">
                                                <Button Classes="subtle mini" Click="OnExportTheme"
                                                        ToolTip.Tip="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ExportThemeText}">
                                                    <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.Export}"/>
                                                </Button>
                                                <Button Classes="danger mini" Click="OnDeleteTheme"
                                                        ToolTip.Tip="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).DeleteThemeText}">
                                                    <Path Classes="btnIcon" Data="{x:Static ctl:Glyphs.Remove}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Warnings}" IsVisible="{Binding HasWarnings}" FontSize="11"
                                                   Foreground="{DynamicResource CedroWarning}" TextWrapping="Wrap" Margin="14,0,14,12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="card">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource CedroAccentSubtle}"
                                    VerticalAlignment="Top" Margin="0,0,14,0">
                                <Path Data="{x:Static ctl:Glyphs.Create}" Stroke="{DynamicResource CedroAccent}" StrokeThickness="1.5"
                                      StrokeJoin="Round" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="cardTitle" Text="{Binding AuthorsTitle}"/>
                                <TextBlock Classes="helper" Text="{Binding AuthorsHelper}"/>
                                <SelectableTextBlock Text="{Binding ThemesFolder}" FontSize="11" FontFamily="Consolas, Cascadia Mono, monospace"
                                                     Foreground="{DynamicResource CedroTextTertiary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- =============================== 5. Position =============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Path Classes="navIcon" Data="{x:Static ctl:Glyphs.Position}"/>
                    <TextBlock Text="{Binding TabDockPositioning}"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Classes="page">
                <StackPanel Classes="page">
                    <TextBlock Classes="pageTitle" Text="{Binding TabDockPositioning}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding PositionSubtitle}" Margin="0,0,0,8"/>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="cardTitle" Text="{Binding PosModeTitle}"/>
                                <TextBlock Classes="helper" Text="{Binding PosModeHelper}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <RadioButton GroupName="posMode" Content="{Binding StaticText}" IsChecked="{Binding IsStaticMode}"/>
                                <RadioButton GroupName="posMode" Content="{Binding DynamicText}" IsChecked="{Binding !IsStaticMode}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding IsStaticMode}">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="cardTitle" Text="{Binding AlignmentTitle}"/>
                            <Grid ColumnDefinitions="Auto,*,24,Auto,*" RowDefinitions="Auto">
                                <TextBlock Text="{Binding VerticalText}" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource CedroTextSecondary}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding VerticalAnchorOptions}" SelectedItem="{Binding SelectedVerticalOption}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnchorOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="3" Text="{Binding HorizontalText}" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource CedroTextSecondary}"/>
                                <ComboBox Grid.Column="4" ItemsSource="{Binding HorizontalAnchorOptions}" SelectedItem="{Binding SelectedHorizontalOption}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HorizontalAnchorOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding IsStaticMode}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="cardTitle" Text="{Binding ScreenSpacingTitle}"/>
                                <TextBlock Classes="helper" Text="{Binding ScreenSpacingHelper}"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="{Binding TopSpacingLabel}" VerticalAlignment="Center" MinWidth="70" Foreground="{DynamicResource CedroTextSecondary}"/>
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TopSpacing}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="value" Text="{Binding TopSpacing, StringFormat='{}{0} px'}"/>
                                <TextBlock Grid.Row="1" Text="{Binding LeftSpacingLabel}" VerticalAlignment="Center" Foreground="{DynamicResource CedroTextSecondary}"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LeftSpacing}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="value" Text="{Binding LeftSpacing, StringFormat='{}{0} px'}"/>
                                <TextBlock Grid.Row="2" Text="{Binding RightSpacingLabel}" VerticalAlignment="Center" Foreground="{DynamicResource CedroTextSecondary}"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RightSpacing}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Classes="value" Text="{Binding RightSpacing, StringFormat='{}{0} px'}"/>
                                <TextBlock Grid.Row="3" Text="{Binding BottomSpacingLabel}" VerticalAlignment="Center" Foreground="{DynamicResource CedroTextSecondary}"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BottomSpacing}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Classes="value" Text="{Binding BottomSpacing, StringFormat='{}{0} px'}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="infoBar" IsVisible="{Binding !IsStaticMode}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding DynamicPosTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DynamicPosHelper}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- =============================== 6. General =============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Path Classes="navIcon" Data="{x:Static ctl:Glyphs.Settings}"/>
                    <TextBlock Text="{Binding TabGeneral}"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Classes="page">
                <StackPanel Classes="page">
                    <TextBlock Classes="pageTitle" Text="{Binding TabGeneral}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding GeneralSubtitle}" Margin="0,0,0,8"/>

                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Classes="cardTitle" Text="{Binding LanguageLabel}"/>
                                <TextBlock Classes="helper" Text="{Binding LanguageHelper}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding SelectedLanguageIndex}"
                                      MinWidth="200" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="18,14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cardTitle" Text="{Binding StartWithWindowsText}"/>
                                    <TextBlock Classes="helper" Text="{Binding StartWithWindowsHelper}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoStartEnabled}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CedroCardBorder}"/>
                            <Grid ColumnDefinitions="*,Auto" Margin="18,14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cardTitle" Text="{Binding ShowUnpinnedRunningAppsText}"/>
                                    <TextBlock Classes="helper" Text="{Binding ShowUnpinnedHelper}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowUnpinnedRunningApps}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CedroCardBorder}"/>
                            <Grid ColumnDefinitions="*,Auto" Margin="18,14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cardTitle" Text="{Binding ArrangeVerticalText}"/>
                                    <TextBlock Classes="helper" Text="{Binding ArrangeVerticalHelper}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsVerticalDock}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CedroCardBorder}"/>
                            <Grid ColumnDefinitions="*,Auto" Margin="18,14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="cardTitle" Text="{Binding LockIconsText}"/>
                                    <TextBlock Classes="helper" Text="{Binding LockIconsHelper}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IconsLocked}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="sectionLabel" Text="{Binding AboutTitle}"/>
                    <Border Classes="card">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Image Source="/Assets/icons/cedro/logo_256.png" Width="48" Height="48" Margin="0,0,16,0"
                                   VerticalAlignment="Top" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding OpenSourceText}" FontWeight="SemiBold"/>
                                <TextBlock Classes="helper" Text="{Binding VersionText}"/>
                                <SelectableTextBlock Text="{Binding RepoText}" FontSize="12" Foreground="{DynamicResource CedroTextSecondary}"/>
                                <SelectableTextBlock Text="{Binding ContactText}" FontSize="12" Foreground="{DynamicResource CedroTextSecondary}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Content="{Binding AcknowledgementsText}" Click="OnAcknowledgements"
                                    VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
