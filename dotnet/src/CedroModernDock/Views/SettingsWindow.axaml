<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CedroModernDock.ViewModels"
        xmlns:med="using:Avalonia.Media"
        x:Class="CedroModernDock.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icons/cedro/logo_256.png"
        Width="780" Height="544"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Closed="OnClosed">

    <Window.Resources>
        <!-- Accent blue for sliders and radio buttons (matches the 7th preset swatch). -->
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#00508C"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#00508C"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#00508C"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#1E6BA6"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#1E6BA6"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#003A63"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#003A63"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#00508C"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#1E6BA6"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#003A63"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#00508C"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#1E6BA6"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#003A63"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Single-row, compact tab strip: the Fluent theme wraps headers in a
             WrapPanel by default, stacking them 2-per-line in this narrow window.
             A horizontal StackPanel keeps all sections side-by-side. -->
        <Style Selector="TabControl">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <!-- Clicking a tab gives it keyboard focus, which draws a 2px focus
                 ring (system accent color) around the selected tab. Disable it. -->
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#3A3A3A"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- The Fluent theme draws a 2px accent-colored pipe under the selected
             tab (PART_SelectedPipe). The blue selected background is already the
             highlight, so suppress the pipe. -->
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Interactive controls in Settings show the pointer cursor on hover. -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- The Fluent theme uses overlay (auto-hiding) scrollbars by default: the
             track is transparent and the thumb collapses to a sliver until hovered.
             Force them always visible so users can see the content is scrollable. -->
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <ScrollViewer Padding="20,20,20,30" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                  AllowAutoHide="False">
        <StackPanel Orientation="Vertical" Spacing="12">
            <!-- Header -->
            <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center" Foreground="#CCCCCC"/>
                <ComboBox ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding SelectedLanguageIndex}"
                          MinWidth="180" Background="#2D2D2D" Foreground="White"/>
            </StackPanel>

            <TabControl Background="Transparent" Padding="0,10,0,10" VerticalContentAlignment="Top">
                <!-- Tab 1: Icons -->
                <TabItem Header="{Binding TabIcons}">
                    <!-- List takes 40% of the available width, actions the rest. -->
                    <Grid ColumnDefinitions="2*,3*" Margin="8">
                        <!-- Left: Dock Items list (taller) -->
                        <StackPanel Orientation="Vertical" Spacing="6" Grid.Column="0">
                            <TextBlock Text="{Binding ItemsTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <Grid Margin="0,0,0,10">
                                <ListBox x:Name="ItemsList" ItemsSource="{Binding ItemEntries}" SelectedIndex="{Binding SelectedItemIndex}"
                                         Background="#2D2D2D" Foreground="White" BorderBrush="#444" BorderThickness="1"
                                         MinHeight="220" MaxHeight="290"
                                         Cursor="SizeAll"
                                         DragDrop.AllowDrop="True"
                                         DragDrop.DragOver="OnItemsDragOver"
                                         DragDrop.DragLeave="OnItemsDragLeave"
                                         DragDrop.Drop="OnItemsDrop"
                                         PointerMoved="OnItemsPointerMoved"
                                         PointerReleased="OnItemsPointerReleased"
                                         PointerCaptureLost="OnItemsPointerCaptureLost">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DockItemListEntry">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                                <Image Source="/Assets/icons/draggable.png" Width="12" Height="12"
                                                       Stretch="Uniform" VerticalAlignment="Center" Opacity="0.55"/>
                                                <Image Source="{Binding Icon}" Width="18" Height="18"
                                                       Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- Insertion indicator: a 2px accent bar shown while a
                                     drag hovers over the list, positioned at the gap. -->
                                <Border x:Name="DropIndicator" IsVisible="False" Height="2"
                                        Background="#007ACC" CornerRadius="1"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                            </Grid>
                        </StackPanel>
                        <!-- Right: Actions (stacked buttons) -->
                        <StackPanel Orientation="Vertical" Spacing="8" Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding ActionsTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding ActionsHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Button Content="{Binding AddProgramText}" Click="OnAddProgram" Background="#007ACC" Foreground="White" BorderBrush="Transparent" Padding="12,6" HorizontalAlignment="Left"/>
                            <Button Content="{Binding AddFolderText}" Click="OnAddFolder" Background="#007ACC" Foreground="White" BorderBrush="Transparent" Padding="12,6" HorizontalAlignment="Left"/>
                            <Button Content="{Binding AddModuleText}" Click="OnAddModule" Background="#007ACC" Foreground="White" BorderBrush="Transparent" Padding="12,6" HorizontalAlignment="Left"/>
                            <Button Content="{Binding RemoveText}" Click="OnRemove" IsEnabled="{Binding CanRemove}" Background="#D33" Foreground="White" BorderBrush="Transparent" Padding="12,6" HorizontalAlignment="Left"/>
                            <Button Content="{Binding MoveUpText}" Click="OnMoveUp" IsEnabled="{Binding CanMoveUp}" Background="#444" Foreground="White" BorderBrush="Transparent" Padding="12,6" HorizontalAlignment="Left"/>
                            <Button Content="{Binding MoveDownText}" Click="OnMoveDown" IsEnabled="{Binding CanMoveDown}" Background="#444" Foreground="White" BorderBrush="Transparent" Padding="12,6" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <!-- Tab 2: Icons Customization -->
                <TabItem Header="{Binding TabIconsCustomization}">
                    <StackPanel Orientation="Vertical" Spacing="16" Margin="16,12">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="{Binding IconSizeTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding IconSizeHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Slider Minimum="16" Maximum="80" Value="{Binding IconSize}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="{Binding SpacingTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding SpacingHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Slider Minimum="0" Maximum="20" Value="{Binding IconSpacing}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <CheckBox Content="{Binding TintIconsTitle}" IsChecked="{Binding TintIcons}" Foreground="#CCCCCC"/>
                            <StackPanel Orientation="Vertical" Spacing="4" IsVisible="{Binding TintIcons}">
                                <TextBlock Text="{Binding TintColorHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="med:IBrush">
                                            <Border Width="32" Height="32" Margin="0,0,8,8" CornerRadius="6"
                                                    Background="{Binding}" BorderBrush="#666" BorderThickness="1"
                                                    PointerPressed="OnTintPresetColorPressed">
                                                <Border.Styles>
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="BorderBrush" Value="White"/>
                                                    </Style>
                                                </Border.Styles>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <Border Width="48" Height="32" CornerRadius="6" BorderBrush="#666" BorderThickness="1"
                                            Background="{Binding TintColorBrush}"/>
                                    <Button Content="{Binding CustomColorText}" Click="OnCustomTintColor" Background="#007ACC" Foreground="White"
                                            BorderBrush="Transparent" Padding="14,6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <!-- more tabs below -->
                <!-- Tab 3: Dock Customization -->
                <TabItem Header="{Binding TabDockCustomization}">
                    <StackPanel Orientation="Vertical" Spacing="16" Margin="16,12">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="{Binding TransparencyTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding TransparencyHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Transparency}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="{Binding RoundingTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding RoundingHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Slider Minimum="0" Maximum="30" Value="{Binding BorderRounding}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="{Binding DockPaddingTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding DockPaddingHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Slider Minimum="0" Maximum="30" Value="{Binding DockPadding}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="{Binding BgColorTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding BgColorHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <!-- Quick-pick presets -->
                            <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="med:IBrush">
                                        <Border Width="32" Height="32" Margin="0,0,8,8" CornerRadius="6"
                                                Background="{Binding}" BorderBrush="#666" BorderThickness="1"
                                                PointerPressed="OnPresetColorPressed">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                </Style>
                                            </Border.Styles>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Current color preview + custom picker -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Border Width="48" Height="32" CornerRadius="6" BorderBrush="#666" BorderThickness="1"
                                        Background="{Binding DockColorBrush}"/>
                                    <Button Content="{Binding CustomColorText}" Click="OnCustomColor" Background="#007ACC" Foreground="White"
                                            BorderBrush="Transparent" Padding="14,6" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <!-- Tab 4: Positioning -->
                <TabItem Header="{Binding TabDockPositioning}">
                    <StackPanel Orientation="Vertical" Spacing="12" Margin="16,12">
                        <TextBlock Text="{Binding PosModeTitle}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <TextBlock Text="{Binding PosModeHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="{Binding StaticText}" IsChecked="{Binding IsStaticMode}" Foreground="White"/>
                            <RadioButton Content="{Binding DynamicText}" IsChecked="{Binding !IsStaticMode}" Foreground="White"/>
                        </StackPanel>

                        <!-- Static-only: alignment + screen spacing -->
                        <StackPanel Orientation="Vertical" IsVisible="{Binding IsStaticMode}">
                            <TextBlock Text="{Binding AlignmentTitle}" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,20,0,16"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding VerticalText}" VerticalAlignment="Center" Foreground="#CCC"/>
                                <ComboBox ItemsSource="{Binding VerticalAnchorOptions}" SelectedItem="{Binding SelectedVerticalOption}"
                                          Background="#2D2D2D" Foreground="White" MinWidth="100">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnchorOption">
                                            <TextBlock Text="{Binding Label}" Foreground="White"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding HorizontalText}" VerticalAlignment="Center" Foreground="#CCC"/>
                                <ComboBox ItemsSource="{Binding HorizontalAnchorOptions}" SelectedItem="{Binding SelectedHorizontalOption}"
                                          Background="#2D2D2D" Foreground="White" MinWidth="100">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HorizontalAnchorOption">
                                            <TextBlock Text="{Binding Label}" Foreground="White"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="{Binding ScreenSpacingTitle}" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,40,0,0"/>
                            <StackPanel Orientation="Vertical" Spacing="6" Margin="0,0,0,80">
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding TopSpacingLabel}" Width="50" Foreground="#CCC" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Value="{Binding TopSpacing}" Width="224"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding LeftSpacingLabel}" Width="50" Foreground="#CCC" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Value="{Binding LeftSpacing}" Width="224"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding RightSpacingLabel}" Width="50" Foreground="#CCC" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Value="{Binding RightSpacing}" Width="224"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding BottomSpacingLabel}" Width="50" Foreground="#CCC" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Value="{Binding BottomSpacing}" Width="224"/></StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic-only: drag hint -->
                        <StackPanel Orientation="Vertical" IsVisible="{Binding !IsStaticMode}">
                            <TextBlock Text="{Binding DynamicPosTitle}" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding DynamicPosHelper}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <!-- general tab below -->
                <!-- Tab 5: General -->
                <TabItem Header="{Binding TabGeneral}">
                    <StackPanel Orientation="Vertical" Spacing="8" Margin="16,12">
                        <TextBlock Text="{Binding OpenSourceText}" Foreground="#CCCCCC" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <CheckBox Content="{Binding StartWithWindowsText}" IsChecked="{Binding IsAutoStartEnabled}" Foreground="#CCCCCC" Margin="0,8,0,0"/>
                        <CheckBox Content="{Binding ShowUnpinnedRunningAppsText}"
                                  IsChecked="{Binding ShowUnpinnedRunningApps}" Foreground="#CCCCCC" Margin="0,8,0,0"/>
                        <CheckBox Content="{Binding ArrangeVerticalText}"
                                  IsChecked="{Binding IsVerticalDock}" Foreground="#CCCCCC" Margin="0,8,0,0"/>
                        <Button Content="{Binding AcknowledgementsText}" Click="OnAcknowledgements"
                                Background="#007ACC" Foreground="White" BorderBrush="Transparent"
                                Padding="16,8" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding VersionText}" Foreground="#CCCCCC"/>
                        <TextBlock Text="{Binding RepoText}" Foreground="#CCCCCC"/>
                        <TextBlock Text="{Binding ContactText}" Foreground="#CCCCCC"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Window>
