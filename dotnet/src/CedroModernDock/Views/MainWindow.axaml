<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CedroModernDock.ViewModels"
        xmlns:ctl="using:CedroModernDock.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="80"
        x:Class="CedroModernDock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Cedro Modern Dock"
        Icon="/Assets/icons/cedro/logo_256.png"
        Width="500" Height="80"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        PointerPressed="OnPointerPressed">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- DockItemButton animates its content; its hit area stays fixed. -->
        <Style Selector="Button.dockItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dockItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.dockItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Running indicator fades in/out instead of popping. -->
        <Style Selector="Panel.indicator">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- The margin is transparent zoom/shadow headroom: the window is sized to
         its content, so hover-zoomed icons and the theme's shadow need room
         past the bar's edge or the window would clip them. -->
    <Panel x:Name="DockBar"
           Margin="{Binding ZoomHeadroomThickness}"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           ContextRequested="OnDockContextRequested">

        <!-- 1. Background: color / gradient, border, shadow -->
        <Border Background="{Binding DockBackground}"
                BorderBrush="{Binding ThemeBorderBrush}"
                BorderThickness="{Binding ThemeBorderThickness}"
                CornerRadius="{Binding DockCornerRadius}"
                BoxShadow="{Binding DockShadow}"/>

        <!-- 2. Optional skin image (9-slice), like classic dock skins -->
        <ctl:NineSliceImage Source="{Binding DockSkin}"
                            Slice="{Binding DockSkinSlice}"
                            Opacity="{Binding DockSkinOpacity}"
                            IsVisible="{Binding HasDockSkin}"
                            IsHitTestVisible="False"/>

        <!-- 3. Glass reflection along the top edge -->
        <Border BorderBrush="{Binding DockHighlight}"
                BorderThickness="0,1,0,0"
                Margin="{Binding ThemeBorderThickness}"
                CornerRadius="{Binding HighlightCornerRadius}"
                IsVisible="{Binding HasDockHighlight}"
                IsHitTestVisible="False"/>

        <!-- 4. Edit mode (icons unlocked): dashed accent outline -->
        <Rectangle Stroke="{Binding AccentBrush}"
                   StrokeThickness="1.5"
                   StrokeDashArray="3,2"
                   RadiusX="{Binding BorderRounding}"
                   RadiusY="{Binding BorderRounding}"
                   IsVisible="{Binding IconsUnlocked}"
                   IsHitTestVisible="False"/>

        <!-- 5. Items -->
        <Border Padding="{Binding DockPaddingThickness}" Background="Transparent">
            <StackPanel Orientation="{Binding DockOrientation}" Spacing="{Binding Spacing}">
                <!-- Pinned dock items. The Fluent theme makes ItemsControl clip to its
                     bounds, which would cut hover-zoomed icons at the bar's padding. -->
                <ItemsControl x:Name="PinnedItems" ItemsSource="{Binding Items}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding DockOrientation}" Spacing="{Binding Spacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DockItemViewModel">
                            <!-- Transparent background so separators are hit-testable
                                 (right-click menu, drag reorder). -->
                            <Panel Background="Transparent" Opacity="{Binding Opacity}">
                                <!-- User-added separator, drawn by the theme -->
                                <Panel IsVisible="{Binding IsSeparator}"
                                       Width="{Binding Style.SeparatorSlotWidth}"
                                       Height="{Binding Style.SeparatorSlotHeight}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding Style.SeparatorImage}" Stretch="Uniform"
                                           IsVisible="{Binding Style.SeparatorIsImage}"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <Border Background="{Binding Style.SeparatorBrush}"
                                            Width="{Binding Style.SeparatorLineWidth}"
                                            Height="{Binding Style.SeparatorLineHeight}"
                                            CornerRadius="1"
                                            IsVisible="{Binding Style.SeparatorIsLine}"/>
                                    <StackPanel Orientation="{Binding Style.SeparatorDotsOrientation}" Spacing="5"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsVisible="{Binding Style.SeparatorIsDots}">
                                        <Ellipse Fill="{Binding Style.SeparatorBrush}" Width="{Binding Style.SeparatorDotSize}" Height="{Binding Style.SeparatorDotSize}"/>
                                        <Ellipse Fill="{Binding Style.SeparatorBrush}" Width="{Binding Style.SeparatorDotSize}" Height="{Binding Style.SeparatorDotSize}"/>
                                        <Ellipse Fill="{Binding Style.SeparatorBrush}" Width="{Binding Style.SeparatorDotSize}" Height="{Binding Style.SeparatorDotSize}"/>
                                    </StackPanel>
                                </Panel>

                                <ctl:DockItemButton Classes="dockItem" HoverZoom="{Binding Style.HoverZoom}"
                                        Command="{Binding ClickCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsButton}"
                                        ToolTip.Tip="{Binding Label}"
                                        ToolTip.Placement="{Binding Style.TooltipPlacement}"
                                        ToolTip.HorizontalOffset="{Binding Style.TooltipHorizontalOffset}"
                                        ToolTip.VerticalOffset="{Binding Style.TooltipVerticalOffset}"
                                        PointerEntered="OnItemPointerEntered"
                                        PointerExited="OnItemPointerExited">
                                    <!-- Icon + running indicator. The indicator slot is
                                         always reserved so running and idle icons align. -->
                                    <StackPanel Orientation="Vertical" Spacing="3" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               Width="{Binding IconSize}"
                                               Height="{Binding IconSize}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        <Panel Classes="indicator"
                                               Height="{Binding Style.IndicatorSlotHeight}"
                                               HorizontalAlignment="Center"
                                               Opacity="{Binding IsRunning, Converter={x:Static vm:Converters.BoolToOpacity}}">
                                            <Border Width="{Binding Style.IndicatorWidth}"
                                                    Height="{Binding Style.IndicatorHeight}"
                                                    CornerRadius="{Binding Style.IndicatorCornerRadius}"
                                                    Background="{Binding Style.IndicatorBrush}"
                                                    BoxShadow="{Binding Style.IndicatorGlow}"
                                                    IsVisible="{Binding Style.IndicatorIsShape}"/>
                                            <Image Source="{Binding Style.IndicatorImage}"
                                                   Width="{Binding Style.IndicatorWidth}"
                                                   Height="{Binding Style.IndicatorHeight}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding Style.IndicatorIsImage}"/>
                                        </Panel>
                                    </StackPanel>
                                </ctl:DockItemButton>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Separator between pinned items and running apps -->
                <Panel IsVisible="{Binding HasRunningApps}"
                       Width="{Binding Style.SeparatorSlotWidth}"
                       Height="{Binding Style.SeparatorSlotHeight}"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="{Binding Style.SeparatorImage}" Stretch="Uniform"
                           IsVisible="{Binding Style.SeparatorIsImage}"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <Border Background="{Binding Style.SeparatorBrush}"
                            Width="{Binding Style.SeparatorLineWidth}"
                            Height="{Binding Style.SeparatorLineHeight}"
                            CornerRadius="1"
                            IsVisible="{Binding Style.SeparatorIsLine}"/>
                    <StackPanel Orientation="{Binding Style.SeparatorDotsOrientation}" Spacing="5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding Style.SeparatorIsDots}">
                        <Ellipse Fill="{Binding Style.SeparatorBrush}" Width="{Binding Style.SeparatorDotSize}" Height="{Binding Style.SeparatorDotSize}"/>
                        <Ellipse Fill="{Binding Style.SeparatorBrush}" Width="{Binding Style.SeparatorDotSize}" Height="{Binding Style.SeparatorDotSize}"/>
                        <Ellipse Fill="{Binding Style.SeparatorBrush}" Width="{Binding Style.SeparatorDotSize}" Height="{Binding Style.SeparatorDotSize}"/>
                    </StackPanel>
                </Panel>

                <!-- Running-but-unpinned apps (taskbar-like) -->
                <ItemsControl ItemsSource="{Binding RunningApps}"
                              IsVisible="{Binding HasRunningApps}"
                              ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding DockOrientation}" Spacing="{Binding Spacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RunningAppViewModel">
                            <ctl:DockItemButton Classes="dockItem" HoverZoom="{Binding Style.HoverZoom}"
                                    ToolTip.Tip="{Binding Label}"
                                    ToolTip.Placement="{Binding Style.TooltipPlacement}"
                                    ToolTip.HorizontalOffset="{Binding Style.TooltipHorizontalOffset}"
                                    ToolTip.VerticalOffset="{Binding Style.TooltipVerticalOffset}"
                                    Click="OnRunningAppClicked"
                                    PointerEntered="OnRunningAppPointerEntered"
                                    PointerExited="OnItemPointerExited">
                                <StackPanel Orientation="Vertical" Spacing="3" HorizontalAlignment="Center">
                                    <Image Source="{Binding Icon}"
                                           Width="{Binding IconSize}"
                                           Height="{Binding IconSize}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                    <Panel Classes="indicator"
                                           Height="{Binding Style.IndicatorSlotHeight}"
                                           HorizontalAlignment="Center"
                                           Opacity="{Binding IsRunning, Converter={x:Static vm:Converters.BoolToOpacity}}">
                                        <Border Width="{Binding Style.IndicatorWidth}"
                                                Height="{Binding Style.IndicatorHeight}"
                                                CornerRadius="{Binding Style.IndicatorCornerRadius}"
                                                Background="{Binding Style.IndicatorBrush}"
                                                BoxShadow="{Binding Style.IndicatorGlow}"
                                                IsVisible="{Binding Style.IndicatorIsShape}"/>
                                        <Image Source="{Binding Style.IndicatorImage}"
                                               Width="{Binding Style.IndicatorWidth}"
                                               Height="{Binding Style.IndicatorHeight}"
                                               Stretch="Uniform"
                                               IsVisible="{Binding Style.IndicatorIsImage}"/>
                                    </Panel>
                                </StackPanel>
                            </ctl:DockItemButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Panel>
</Window>
